{
  "expo": {
    "name": "After Dark",
    "slug": "after-dark",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "afterdark",
    "android": {
      "package": "app.afterdark.mobile"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow After Dark to access photos you select.",
          "savePhotosPermission": "Allow After Dark to save your share cards.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
